# Application Environment Configuration
# Node environment (development, production, test)
NODE_ENV=development

# Database URL for PostgreSQL (Prisma)
# Example: postgresql://username:password@localhost:5432/affiliate_course_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/affiliate_course_db?schema=public"

# Session & JWT Secret (Generate with: openssl rand -base64 32)
SESSION_SECRET="your-super-secret-random-key-at-least-32-characters-long"

# Base URL for affiliate tracking links & public routing
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Super Admin Seed Credentials (used by `npm run db:seed`)
INITIAL_ADMIN_EMAIL="admin@platform.com"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword123!"
INITIAL_ADMIN_NAME="System Super Admin"

# bKash Payment Instructions Defaults (Configurable via Admin Dashboard Settings)
DEFAULT_BKASH_NUMBER="01700000000"
DEFAULT_BKASH_TYPE="MERCHANT" # MERCHANT or PERSONAL
DEFAULT_MINIMUM_PAYOUT="1000" # in BDT
DEFAULT_ATTRIBUTION_DAYS="30" # Cookie window in days
